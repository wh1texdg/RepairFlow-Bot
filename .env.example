APP_NAME=RepairFlow
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://repairflow:repairflow@postgres:5432/repairflow

BOT_TOKEN=
MANAGER_IDS=

# Minified JSON of a Google service-account credential.
# Keep this only in .env / secret storage; never commit it.
GOOGLE_CREDENTIALS=
GOOGLE_SHEET_ID=

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
